# Environment Configuration
ENVIRONMENT=development

# Qdrant Vector DB Configuration
QDRANT_URL=https://your-qdrant-instance.aws.cloud.qdrant.io
QDRANT_API_KEY=your-api-key-here
QDRANT_COLLECTION_NAME=rag-docs

# ColPali Model Configuration
COLPALI_MODEL_NAME=vidore/colpali-v1.2
EMBEDDING_DIM=128

# PDF Upload Limits
MAX_PDF_SIZE_MB=10
MAX_PDF_PAGES=20

# User Quotas
USER_QUOTA_MB=100
USER_CONCURRENT_UPLOADS=3

# Document TTL (Time To Live) - 1 day = 86400 seconds
DOCUMENT_TTL_SECONDS=86400

# Cleanup Job Interval
CLEANUP_INTERVAL_HOURS=6

# User ID Secret Key (REQUIRED - Set a strong random string in production)
USER_ID_SECRET=6bc1d8b71e4530dad794acd5bd25068379fe71cb90a78b2031357e70cb36350f

# AWS S3 Configuration
S3_BUCKET_NAME=your-s3-bucket-name
AWS_REGION=us-east-1

# CORS Configuration
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://your-domain.com
